# Kardna Node server
PORT=8080
HOST=0.0.0.0

# Wisp abuse protection. Increase cautiously for a trusted private deployment.
WISP_MAX_CONNECTIONS_PER_IP=4
WISP_MAX_UPGRADES_PER_MINUTE=30

# Production should be served through HTTPS so the browser can use secure
# service workers and WSS. No proxy credentials belong in frontend variables.
